# Ưu tiên cao nhất — chỉ set khi cần override thủ công
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# Mặc định app tự lấy IP từ Metro (QR code) khi chạy trên máy thật.
# iOS Simulator / Android Emulator vẫn dùng localhost / 10.0.2.2.

# GitHub OAuth: BE cần GITHUB_CLIENT_ID/SECRET/CALLBACK_URL
# App redirect: mobile://auth/callback (scheme trong app.json)

# Tùy chọn — hiển thị trên app (không hardcode trong code)
# EXPO_PUBLIC_WEB_URL=https://seal.example.com
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# EXPO_PUBLIC_SUPPORT_PHONE=+84...

